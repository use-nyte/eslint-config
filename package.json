{
  "name": "@use-nyte/eslint-config",
  "version": "2.1.0",
  "description": "Shared ESLint config for use-nyte projects.",
  "repository": "https://github.com/use-nyte/eslint-config",
  "license": "Apache-2.0",
  "main": "src/eslint.config.mjs",
  "bin": {
    "lint": "src/cli.mjs"
  },
  "scripts": {
    "build": "pnpm pack --dry-run --ignore-scripts",
    "test": "node --test",
    "lint": "node src/cli.mjs",
    "format": "pnpm exec format",
    "prepare": "husky"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-solid": "0.20.1",
    "globals": "17.14.0",
    "typescript-eslint": "8.74.0"
  },
  "devDependencies": {
    "@use-nyte/prettier-config": "2.0.4",
    "husky": "9.1.7"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": "26.13.0"
  },
  "packageManager": "pnpm@12.23.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  }
}
